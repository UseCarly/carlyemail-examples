OPENAI_API_KEY=sk-...
CARLYEMAIL_API_KEY=ce_us_...            # the buyer's key; also the seller's unless SELLER_API_KEY is set
BUYER_INBOX=buyer@carlyemail.com
SELLER_INBOX=seller@carlyemail.com
SELLER_EMAIL=seller@carlyemail.com       # where the buyer writes; same as SELLER_INBOX when one key runs both
# SELLER_API_KEY=ce_us_...               # only if the seller is in another organization
OWNER_EMAIL=you@yourcompany.com          # gets the buyer's closing summary
BUDGET=16000
FLOOR=15500
MAX_ROUNDS=6
