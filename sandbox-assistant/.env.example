# Your Anthropic account. The agent and its sandbox are billed here, not to
# CarlyEmail — we only deliver the mail
ANTHROPIC_API_KEY=sk-ant-...

# Printed by setup.py. Run it once, then never again
ANTHROPIC_AGENT_ID=agent_...
ANTHROPIC_ENVIRONMENT_ID=env_...

# From sign-up, or the console at console.carlyemail.com
CARLYEMAIL_API_KEY=ce_us_...

# The mailbox this agent answers
CARLYEMAIL_INBOX=assistant@carlyemail.com

# Returned once, when you create the webhook
CARLYEMAIL_WEBHOOK_SECRET=whsec_...

# Who may give this agent work. Comma-separated. Leave empty and anyone who
# learns the address can run code in your sandbox on your bill
ALLOWED_SENDERS=you@yourcompany.com
