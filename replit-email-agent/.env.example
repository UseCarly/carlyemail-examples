# On Replit these go under Secrets in the sidebar, not in a file.

# From sign-up, or the console at console.carlyemail.com
CARLYEMAIL_API_KEY=ce_us_...

# For the model that writes the replies
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Which mailbox to answer on. Left unset, the first inbox on the
# account is used, and one is created if there are none
CARLYEMAIL_INBOX=assistant@carlyemail.com

# Optional but recommended. Who may give this agent work — comma-separated.
# An entry beginning with @ allows a whole domain. Leave it empty and anybody
# who learns the address can
ALLOWED_SENDERS=you@yourcompany.com

# Optional. Set this only when running outside Replit, or on a custom domain
# the repl cannot discover for itself
PUBLIC_URL=https://agent.yourcompany.com
