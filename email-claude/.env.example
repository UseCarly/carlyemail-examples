# Your Anthropic account. Every reply is billed here, not to CarlyEmail — we
# only deliver the mail
ANTHROPIC_API_KEY=sk-ant-...

# From sign-up, or the console at console.carlyemail.com
CARLYEMAIL_API_KEY=ce_us_...

# The mailbox Claude answers
CARLYEMAIL_INBOX=claude@carlyemail.com

# Returned once, when you create the webhook
CARLYEMAIL_WEBHOOK_SECRET=whsec_...

# Who may write to it. Comma-separated; an entry starting with @ allows a
# whole domain. Leave it empty and anyone who learns the address can run up
# your Anthropic bill
ALLOWED_SENDERS=you@yourcompany.com
